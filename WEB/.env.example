# Copiar a .env.local (git-ignorado) para pisar valores en el propio equipo.
# OJO: Vite solo lee .env.local (o .env/.env.[modo].local) - este archivo
# .env.example es nada más una plantilla de referencia, no lo carga la app.

# URL base de la API. Sin definir, se usa http://localhost:3000 (sirve para
# desarrollo normal, navegador y API en la misma PC). Para probar desde un
# celular a través de un túnel, tunelizar TAMBIÉN el puerto de la API y poner
# acá esa URL (ej. https://xxxx-3000.tu-tunel.dev).
VITE_API_URL=http://localhost:3000
